# FrostAura Integrations — Environment Variables
# Copy to .env and adjust before running docker compose up.
#
# NOTE: there are deliberately NO provider credentials here. This service
# stores none — every caller supplies their own per request as HTTP headers.
# If you find yourself adding a WOOLWORTHS_PASSWORD here, stop and read the
# decision recorded in memory/decisions.md first.

# ============================================================================
# Host
# ============================================================================
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
